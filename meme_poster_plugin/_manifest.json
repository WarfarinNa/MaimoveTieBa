{
  "manifest_version": 1,
  "name": "智能贴吧内容推送系统",
  "version": "2.0.0",
  "description": "智能获取贴吧内容，利用LLM进行评价和推送的插件",
  "author": {
    "name": "MaiBot开发者",
    "url": "https://github.com/MaiM-with-u"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "0.7.0",
    "max_version": "1.0.0"
  },
  "homepage_url": "https://github.com/MaiM-with-u",
  "repository_url": "https://github.com/MaiM-with-u/plugin-repo",
  "keywords": ["贴吧", "LLM", "智能推送", "内容评价", "多群组", "随机时间"],
  "categories": ["Entertainment & Interaction", "External Integration", "AI & Machine Learning"],
  "default_locale": "zh-CN",
  "plugin_info": {
    "is_built_in": false,
    "plugin_type": "general",
    "components": [
      {
        "type": "action",
        "name": "tieba_content_action",
        "description": "智能推送贴吧内容"
      },
      {
        "type": "command",
        "name": "tieba_status_command",
        "description": "查看贴吧推送状态"
      },
      {
        "type": "command",
        "name": "tieba_config_command",
        "description": "管理贴吧推送配置"
      }
    ]
  }
}
